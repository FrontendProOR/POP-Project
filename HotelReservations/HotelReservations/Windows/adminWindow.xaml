<Window x:Class="HotelReservations.Windows.adminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelReservations.Windows"
        mc:Ignorable="d"
        Title="adminWindow" Height="450" Width="800">
    <Grid>
        <!-- Menu -->
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="General" Height="30">
                <MenuItem Name="UsersMI" Header="Users" Click="UsersMI_Click"/>
                <MenuItem Name="UserTypesMI" Header="User Types" Click="UserTypesMI_Click"/>
                <MenuItem Name="GuestsMI" Header="Guests" Click="GuestsMI_Click"/>
                <MenuItem Name="RoomsMI" Header="Rooms" Click="RoomsMI_Click"/>
                <MenuItem Name="RoomTypesMI" Header="RoomTypes" Click="RoomTypesMI_Click"/>
                <MenuItem Name="PricesMI" Header="Prices" Click="PricesMI_Click"/>
            </MenuItem>

            <MenuItem Name="Logout" Header="Logout" Click="Logout_Click" HorizontalAlignment="Right"></MenuItem>
      
        </Menu>

        <!-- Logout button -->
    </Grid>
</Window>
