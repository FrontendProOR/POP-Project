<Window x:Class="HotelReservations.Windows.AddEditUserTypes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelReservations.Windows"
        mc:Ignorable="d"
        Title="AddEditUserTypes" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Label Content="User Type Name:" Width="150" HorizontalAlignment="Left"/>
                <TextBox x:Name="UserTypeNameTB" Width="200"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
            <Button Content="Cancel" Width="100"  Height="30" Margin="0,0,10,0" Click="CancelBtn_Click"/>
            <Button Content="Save" Width="100" Height="30" Click="SaveBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
