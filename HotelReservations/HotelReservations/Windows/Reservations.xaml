<Window x:Class="HotelReservations.Windows.Reservations"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelReservations.Windows"
        mc:Ignorable="d"
        Title="Reservations" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Name="AddBtn" Content="Add" BorderBrush="LightGray" Click="AddBtn_Click"/>
            <Button Name="EditBtn" Content="Edit" BorderBrush="LightGray" Margin="5,0,0,0"  Click="EditBtn_Click" />
            <Button Name="DeleteBtn" Content="Delete" BorderBrush="LightGray" Margin="5,0,0,0" Click="DeleteBtn_Click"/>
        </ToolBar>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label Content="Room Number:"/>
            <TextBox Name="RoomNumberTextBox" Width="30"/>
            <Label Content="Arrival Date:"/>
            <DatePicker Name="ArrivalDatePicker"/>
            <Label Content="Departure Date:"/>
            <DatePicker Name="DepartureDatePicker"/>
            <Button Content="Search" Click="SearchBtn_Click"/>
            <TextBlock Grid.Row="0" Margin="10,0,0,0" VerticalAlignment="Center" Text="Sort by:"/>
            <ComboBox Name="SortByComboBox" Grid.Row="0" Margin="5" Width="30" SelectionChanged="SortByComboBox_SelectionChanged">
                <ComboBoxItem Content="Sort by Arrival Date"/>
                <ComboBoxItem Content="Sort by Departure Date"/>
                <ComboBoxItem Content="Sort by Price"/>
            </ComboBox>
            <ComboBox Name="SortOrderComboBox" Grid.Row="0" Margin="5" Width="30" SelectionChanged="SortByComboBox_SelectionChanged">
                <ComboBoxItem Content="Ascending"/>
                <ComboBoxItem Content="Descending"/>
            </ComboBox>

        </StackPanel>

        <DataGrid Name="ReservationsDG" Grid.Row="2" 
        IsReadOnly="True" AutoGeneratingColumn="ReservationsDG_AutoGeneratingColumn" MouseDoubleClick="ReservationsDG_MouseDoubleClick" />
        

    </Grid>
</Window>
