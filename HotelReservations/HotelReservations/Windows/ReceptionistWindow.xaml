<Window x:Class="HotelReservations.Windows.ReceptionistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelReservations.Windows"
        mc:Ignorable="d"
        Title="ReceptionistWindow" Height="450" Width="800">
    <Grid>
        <!-- Menu -->
        <Menu>
            <MenuItem Header="Reservations" Click="OpenReservationsWindow"/>
            <MenuItem Header="Guests" Click="OpenGuestsWindow"/>
            <MenuItem Name="Logout" Header="Logout" Click="Logout_Click" HorizontalAlignment="Right"></MenuItem>
            <!-- Add more menu items as needed -->
        </Menu>

        <!-- You can include other UI elements for the ReceptionistWindow below the menu -->
    </Grid>
</Window>
