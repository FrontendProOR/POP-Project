<Window x:Class="HotelReservations.Windows.ReservationGuests"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelReservations.Windows"
        mc:Ignorable="d"
        Title="ReservationGuests" Height="500" Width="800">
    <Grid>
        <DataGrid AutoGeneratingColumn="GuestsDG_AutoGeneratingColumn" Margin="20,20,20,80" Name="GuestsDG" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" />
        <Button Content="Close" Height="30" HorizontalAlignment="Right" Margin="0,0,20,30" Name="btnClose" VerticalAlignment="Bottom" Width="100" Click="btnClose_Click" />
        <Button Content="Pick" Height="30" HorizontalAlignment="Right" Margin="237,0,140,30" Name="btnPick" VerticalAlignment="Bottom" Width="60" Click="btnPickGuest_Click" />
    </Grid>
</Window>
