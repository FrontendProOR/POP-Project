<Window x:Class="HotelReservations.Windows.ReservationGuests"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelReservations.Windows"
        mc:Ignorable="d"
        Title="ReservationGuests" Height="450" Width="800">
    <Grid>
        <DataGrid AutoGeneratingColumn="GuestsDG_AutoGeneratingColumn" Margin="12,12,12,92" Name="GuestsDG" IsReadOnly="True"/>
        <Button Content="Close" Height="39" HorizontalAlignment="Right" Margin="0,0,12,31" Name="btnClose" VerticalAlignment="Bottom" Width="102" Click="btnClose_Click" />
        <Button Content="Pick" Height="39" HorizontalAlignment="Left" Margin="237,0,0,31" Name="btnPick" VerticalAlignment="Bottom" Width="66" Click="btnPickGuest_Click" />
    </Grid>
</Window>
