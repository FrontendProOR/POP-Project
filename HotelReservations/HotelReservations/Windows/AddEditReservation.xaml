<Window x:Class="HotelReservations.Windows.AddEditReservation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelReservations.Windows"
        mc:Ignorable="d"
        Title="AddEditReservation" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel
             Grid.Row="1"
             Grid.Column="1"
             Orientation="Vertical"
             >

            <StackPanel
                 Orientation="Horizontal"
                 >
                <Label 
                     Height="30"
                     Width="150"
                     Content="Reservation type:"/>
                <ComboBox 
                     Name="ReservationTypesCB"
                     Height="30" 
                     Width="150"
                     VerticalContentAlignment="Center"
                     SelectedItem="{Binding ReservationType}"/>
            </StackPanel>

            <StackPanel
                 Orientation="Horizontal"
                 >
                <Label 
                     Height="30"
                     Width="150"
                     Content="Start DateTime:"/>
                <DatePicker
                    Height="30"
                    Width="150"
                    Name="datePicker1"
                    SelectedDate="{Binding StartDateTime}">
                </DatePicker>
            </StackPanel>

            <StackPanel
                 Orientation="Horizontal"
                 >
                <Label 
                     Height="30"
                     Width="150"
                     Content="End DateTime:"/>
                <DatePicker
                    Height="30"
                    Width="150"
                    Name="datePicker"
                    SelectedDate="{Binding EndDateTime}">
                </DatePicker>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label 
                     Height="30"
                     Width="150"
                     Content="Total Price:"
                     Margin="0,0,0,15"
                     ></Label>
                <TextBox 
                     Name="PriceValueTB"
                     Height="30"
                     Width="150"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,15"
                     Text="{Binding Path=TotalPrice, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}">
                    <Validation.ErrorTemplate>
                        <ControlTemplate>
                            <StackPanel>
                                <AdornedElementPlaceholder/>
                                <TextBlock Text="{Binding [0].ErrorContent}" Foreground="Red"></TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </Validation.ErrorTemplate>
                </TextBox>
                <Label Content="*" />
            </StackPanel>
        </StackPanel>

        <StackPanel
             Grid.Row="2" Grid.Column="1"
             Orientation="Vertical"
             >

            <StackPanel
                Orientation="Horizontal">
                <Label FontSize="20" Name="ReservationGuests" Content="Guests" Width="270" />
                <Button Content="..." Name="btnPickGuests" VerticalAlignment="Center" Width="40" Click="btnPickGuest_Click" />
            </StackPanel>


            <StackPanel
                Orientation="Vertical">
                <DataGrid AutoGenerateColumns="True" Height="150" Width="320" Margin="0,10,0,0" Name="ReservationGuestsDG" IsReadOnly="True" AutoGeneratingColumn="ReservationGuestsDG_AutoGeneratingColumn" />
            </StackPanel>
        </StackPanel>

        <StackPanel
             Grid.Row="3" Grid.Column="2"
             Orientation="Horizontal"
             FlowDirection="RightToLeft"
             >
            <Button 
                 Name="SaveBtn"
                 Content="Save"
                 Width="80"
                 Height="30"
                 Margin="5,0,5,0"
                 Click="SaveBtn_Click"
                 />
            <Button 
                 Name="CancelBtn"
                 Content="Cancel"
                 Width="80"
                 Height="30"
                 Click="CancelBtn_Click"
                 />
        </StackPanel>
    </Grid>
</Window>
