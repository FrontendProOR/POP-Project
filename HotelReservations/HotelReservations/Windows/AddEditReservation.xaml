<Window x:Class="HotelReservations.Windows.AddEditReservation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelReservations.Windows"
        mc:Ignorable="d"
        Title="AddEditReservation" Height="650" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="300"/>

            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel
             Grid.Row="1"
             Grid.Column="1"
             Orientation="Vertical"
             >

            <StackPanel
                 Orientation="Horizontal" Margin="10,10"
                 >
                <Label 
                     Height="30"
                     Width="150"
                     Content="Reservation type:"/>
                <ComboBox 
                     Name="ReservationTypesCB"
                     Height="30" 
                     Width="150"
                     VerticalContentAlignment="Center"
                     SelectedItem="{Binding ReservationType}"/>
            </StackPanel>

            <StackPanel
                 Orientation="Horizontal" Margin="10,10"
                 >
                <Label 
                     Height="30"
                     Width="150"
                     Content="Start DateTime:"/>
                <DatePicker
                    Height="30"
                    Width="150"
                    Name="datePicker1"
                    SelectedDate="{Binding StartDateTime}">
                </DatePicker>
            </StackPanel>

            <StackPanel
                 Orientation="Horizontal" Margin="10,10"
                 >
                <Label 
                     Height="30"
                     Width="150"
                     Content="End DateTime:"/>
                <DatePicker
                    Height="30"
                    Width="150"
                    Name="datePicker"
                    SelectedDate="{Binding EndDateTime}">
                </DatePicker>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10,10">
                <Label 
                     Height="30"
                     Width="150"
                     Content="Total Price:"
                     Margin="0,0,0,15"
                     ></Label>
                <TextBox 
                     Name="PriceValueTB"
                     Height="30"
                     Width="150"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,15"
                     Text="{Binding Path=TotalPrice, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}">
                    <Validation.ErrorTemplate>
                        <ControlTemplate>
                            <StackPanel>
                                <AdornedElementPlaceholder/>
                                <TextBlock Text="{Binding [0].ErrorContent}" Foreground="Red"></TextBlock>
                            </StackPanel>
                        </ControlTemplate>
                    </Validation.ErrorTemplate>
                </TextBox>
                <Label Content="*" />
            </StackPanel>
        </StackPanel>

        <StackPanel
             Grid.Row="2" Grid.Column="1"
             Orientation="Vertical"
             >

            <StackPanel
                Orientation="Horizontal">
                <Label FontSize="20" Name="ReservationGuests" Content="Guests" Width="270" />
                <Button Content="..." Name="btnPickGuests" VerticalAlignment="Center" Width="40" Click="btnPickGuest_Click" />
            </StackPanel>


                <!--<DataGrid AutoGenerateColumns="True" Height="150" Width="320" Margin="0,10,0,0" Name="ReservationGuestsDG" IsReadOnly="True" AutoGeneratingColumn="ReservationGuestsDG_AutoGeneratingColumn" SelectionChanged="ReservationGuestsDG_SelectionChanged" />-->
                <!--
            <StackPanel
                Orientation="Vertical">
                <DataGrid AutoGenerateColumns="False" Height="150" Width="320" Margin="0,10,0,0" Name="ReservationGuestsDG" IsReadOnly="True" AutoGeneratingColumn="ReservationGuestsDG_AutoGeneratingColumn" SelectionChanged="ReservationGuestsDG_SelectionChanged">
    <DataGrid.Columns>
        <DataGridTextColumn Header="Reservation ID" Binding="{Binding ReservationId.Id}" />
        <DataGridTextColumn Header="Guest ID" Binding="{Binding GuestId.Id}" />
    </DataGrid.Columns>
</DataGrid>
                
            </StackPanel>
                -->

        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical">
            <Label Content="Available Rooms" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="3">
                <Label Content="Room Number: " FontSize="16" Margin="0,0,0,5"/>
                <TextBox Name="RoomNumberSearchTB" Height="30" Width="150" VerticalContentAlignment="Center" 
                 TextChanged="RoomNumberSearchTB_TextChanged"/>
                <Label Content="Room type:" VerticalContentAlignment="Center" Margin="3,0,0,0"/>
                <ComboBox Name="RoomTypeSearchCB" Width="150" Margin="3" SelectionChanged="RoomTypeSearchCB_SelectionChanged"/>
            </StackPanel>

            
            <DataGrid x:Name="AvailableRoomsDG" AutoGenerateColumns="False" Height="190" Width="320" Margin="0,10,0,0" IsReadOnly="True" SelectionChanged="AvailableRoomsDG_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="RoomNumber" Binding="{Binding RoomNumber}" />
                    <!-- Add other columns as needed -->
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>


        <StackPanel
             Grid.Row="4" Grid.Column="2"
             Orientation="Horizontal"
             FlowDirection="RightToLeft"
             >
            <Button 
                 Name="SaveBtn"
                 Content="Save"
                 Width="80"
                 Height="30"
                 Margin="5,0,5,0"
                 Click="SaveBtn_Click"
                 />
            <Button 
                 Name="CancelBtn"
                 Content="Cancel"
                 Width="80"
                 Height="30"
                 Click="CancelBtn_Click"
                 />
        </StackPanel>
    </Grid>
</Window>
